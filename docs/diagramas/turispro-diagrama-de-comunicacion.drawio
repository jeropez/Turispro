#14303a;strokeWidth=2;fontSize=11;fontColor=#14303a;labelBackgroundColor=#f7fafb;" edge="1" parent="1" source="pro" target="srv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k4" value="5 calcularEstimado(propuesta)" style="html=1;endArrow=none;strokeColor=#14303a;strokeWidth=2;fontSize=11;fontColor=#14303a;labelBackgroundColor=#f7fafb;edgeStyle=orthogonalEdgeStyle;exitX=0.25;exitY=0;entryX=0.75;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="srv" target="srv"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="968" y="114"/><mxPoint x="1062" y="114"/></Array></mxGeometry></mxCell><mxCell id="k5" value="8 → usarYEditar()" style="html=1;endArrow=none;strokeColor=#14303a;strokeWidth=2;fontSize=11;fontColor=#14303a;labelBackgroundColor=#f7fafb;" edge="1" parent="1" source="asi" target="pro"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k6" value="9 ← «create» PlanTuristico(estado&lt;br&gt;= BORRADOR)" style="html=1;endArrow=none;strokeColor=#14303a;strokeWidth=2;fontSize=11;fontColor=#14303a;labelBackgroundColor=#f7fafb;" edge="1" parent="1" source="plan" target="pro"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k7" value="10 → abrir(plan)" style="html=1;endArrow=none;strokeColor=#14303a;strokeWidth=2;fontSize=11;fontColor=#14303a;labelBackgroundColor=#f7fafb;" edge="1" parent="1" source="asi" target="edi"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k8" value="11 → ajustarDíasYRecursos()" style="html=1;endArrow=none;strokeColor=#14303a;strokeWidth=2;fontSize=11;fontColor=#14303a;labelBackgroundColor=#f7fafb;" edge="1" parent="1" source="adm" target="edi"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k9" value="12 → calcularCostos()&lt;br&gt;14 → guardarBorrador()" style="html=1;endArrow=none;strokeColor=#14303a;strokeWidth=2;fontSize=11;fontColor=#14303a;labelBackgroundColor=#f7fafb;" edge="1" parent="1" source="edi" target="plan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k10" value="13 ← subtotal()" style="html=1;endArrow=none;strokeColor=#14303a;strokeWidth=2;fontSize=11;fontColor=#14303a;labelBackgroundColor=#f7fafb;" edge="1" parent="1" source="con" target="plan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nota" value="Si el servicio falla o no hay recursos del destino, AsistenteIA informa la situación y ofrece continuar por la ruta manual. La propuesta nunca se publica sola." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9e6;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#14303a;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="460" height="64" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="cm2" name="Publicar un plan (HU12)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="TurisPro · Diagrama de comunicación: Publicar un plan (HU12)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1300" height="34" as="geometry"/></mxCell><mxCell id="adm" value="«actor»&lt;br&gt;&lt;b&gt;:Administrador&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1e5e8;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#14303a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="190" height="56" as="geometry"/></mxCell><mxCell id="edi" value="«pantalla»&lt;br&gt;&lt;b&gt;:Editor&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#14303a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="250" width="190" height="56" as="geometry"/></mxCell><mxCell id="plan" value="&lt;b&gt;:PlanTuristico&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#14303a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="250" width="190" height="56" as="geometry"/></mxCell><mxCell id="con" value="&lt;b&gt;:ConceptoCosto&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#14303a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1380" y="250" width="190" height="56" as="geometry"/></mxCell><mxCell id="k0" value="1 → publicar() (paso Revisión)&lt;br&gt;7 ← [sin pendientes] plan&lt;br&gt;publicado, aparece en el filtro&lt;br&gt;Publicados&lt;br&gt;8 ← [hay pendientes]&lt;br&gt;indicarLoPendiente(); el plan&lt;br&gt;sigue en Borrador" style="html=1;endArrow=none;strokeColor=#14303a;strokeWidth=2;fontSize=11;fontColor=#14303a;labelBackgroundColor=#f7fafb;" edge="1" parent="1" source="adm" target="edi"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k1" value="2 → validarParaPublicar()&lt;br&gt;5 → [sin pendientes] publicar()" style="html=1;endArrow=none;strokeColor=#14303a;strokeWidth=2;fontSize=11;fontColor=#14303a;labelBackgroundColor=#f7fafb;" edge="1" parent="1" source="edi" target="plan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="k2" value="3 validarDatosYDuración()&lt;br&gt;6 [sin pendientes] estado =&lt;br&gt;PUBLICADO" style="html=1;endArrow=none;strokeColor=#14303a;strokeWidth=2;fontSize=11;fontColor=#14303a;labelBackgroundColor=#f7fafb;edgeStyle=orthogonalEdgeStyle;exitX=0.25;exitY=0;entryX=0.75;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="plan" target="plan"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="988" y="214"/><mxPoint x="1082" y="214"/></Array></mxGeometry></mxCell><mxCell id="k3" value="4 ← subtotal() (¿costos&lt;br&gt;calculables?)" style="html=1;endArrow=none;strokeColor=#14303a;strokeWidth=2;fontSize=11;fontColor=#14303a;labelBackgroundColor=#f7fafb;" edge="1" parent="1" source="con" target="plan"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="nota" value="El mismo flujo se usa en volverAPublicar() para un plan Archivado (HU13)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9e6;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#14303a;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="460" height="64" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>