<mxfile host="app.diagrams.net"><diagram id="cm1" name="Crear un plan con IA y adopt"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="TurisPro · Diagrama de comunicación: Crear un plan con IA y adoptarlo (HU09, HU10, HU06)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1300" height="34" as="geometry"/></mxCell><mxCell id="adm" value="«actor»&lt;br&gt;&lt;b&gt;:Administrador&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1e5e8;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#14303a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="190" height="56" as="geometry"/></mxCell><mxCell id="asi" value="«pantalla»&lt;br&gt;&lt;b&gt;:AsistenteIA&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#14303a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="150" width="190" height="56" as="geometry"/></mxCell><mxCell id="srv" value="«servicio»&lt;br&gt;&lt;b&gt;:ServicioIA&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#14303a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="150" width="190" height="56" as="geometry"/></mxCell><mxCell id="rec" value="catálogo&lt;br&gt;&lt;b&gt;:Recurso&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#14303a;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1360" y="150" width="190" height="56" as="geometry"/></mxCell><mxCell id="pro" value="&lt;b&gt;:PropuestaIA&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontColor=#14303a;fontSize=12;" vertex="1" parent="1"