# Copia este archivo a backend/.env y completa los valores. NUNCA subas .env al repositorio.
PUERTO=4000
FRONTEND_URL=http://localhost:5173

# Supabase: Project Settings → API. La clave service_role solo va aquí (backend), jamás en el frontend.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# JWT propio. Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRETO=
JWT_EXPIRA=8h

# IA con GroqCloud (HU09). Clave en console.groq.com → API Keys. Sin clave, la IA avisa y se sigue por la ruta manual.
# Verifica el ID del modelo vigente en console.groq.com/docs/models (los modelos se renuevan).
GROQ_API_KEY=
GROQ_MODELO=llama-3.3-70b-versatile
