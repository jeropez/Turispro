<mxfile host="app.diagrams.net"><diagram id="est1" name="Estados del PlanTuristico"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="640" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="TurisPro · Estados del PlanTuristico" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="800" height="34" as="geometry"/></mxCell><mxCell id="i" value="" style="ellipse;fillColor=#14303a;strokeColor=#14303a;" vertex="1" parent="1"><mxGeometry x="40" y="202" width="26" height="26" as="geometry"/></mxCell><mxCell id="bor" value='&lt;div style="text-align:center"&gt;&lt;b&gt;Borrador&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;entry / estado = BORRADOR&lt;br&gt;editar() / sin cambio de estado&lt;br&gt;guardarBorrador() / conserva los datos&lt;br&gt;publicar() [falta información] / se mantiene&lt;br&gt;Borrador y se indica lo pendiente' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=6;spacingTop=4;fontSize=12;fontColor=#14303a;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="260" y="130" width="320" height="170" as="geometry"/></mxCell><mxCell id="pub" value='&lt;div style="text-align:center"&gt;&lt;b&gt;Publicado&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;entry / estado = PUBLICADO&lt;br&gt;editar() / sin cambio de estado&lt;br&gt;do / visible en el catálogo interno' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=6;spacingTop=4;fontSize=12;fontColor=#14303a;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="880" y="155" width="320" height="120" as="geometry"/></mxCell><mxCell id="arc" value='&lt;div style="text-align:center"&gt;&lt;b&gt;Archivado&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;entry / estado = ARCHIVADO&lt;br&gt;editar() / sin cambio de estado&lt;br&gt;do / conserva toda su información' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=6;spacingTop=4;fontSize=12;fontColor=#14303a;fillColor=#e1e5e8;strokeColor=#8a97a0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="880" y="400" width="320" height="120" as="geometry"/></mxCell><mxCell id="n0" value="Un plan nuevo, manual o con «Usar y editar» de la IA, empieza siempre como Borrador. Editar nunca cambia el estado por sí solo. No existe eliminación definitiva, por eso el diagrama no tiene estado final." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9e6;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#14303a;" vertex="1" parent="1"><mxGeometry x="260" y="400" width="400" height="110" as="geometry"/></mxCell><mxCell id="e0" value="guardarBorrador()&lt;br&gt;[nombre indicado]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=10;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;exitDx=0;exitDy=0;entryDx=0;entryDy=0;strokeColor=#14303a;strokeWidth=2;fontSize=11;fontColor=#14303a;labelBackgroundColor=#f7fafb;" edge="1" parent="1" source="i" target="bor"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="publicar()&lt;br&gt;[datos básicos completos, días = duración&lt;br&gt;y costos calculables]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=10;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;exitDx=0;exitDy=0;entryDx=0;entryDy=0;strokeColor=#14303a;strokeWidth=2;fontSize=11;fontColor=#14303a;labelBackgroundColor=#f7fafb;" edge="1" parent="1" source="bor" target="pub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="archivar()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=10;exitX=0.2500;exitY=1.0000;entryX=0.2500;entryY=0.0000;exitDx=0;exitDy=0;entryDx=0;entryDy=0;strokeColor=#14303a;strokeWidth=2;fontSize=11;fontColor=#14303a;labelBackgroundColor=#f7fafb;" edge="1" parent="1" source="pub" target="arc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="volverAPublicar()&lt;br&gt;[revisión y mismas validaciones correctas]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=10;exitX=0.7500;exitY=0.0000;entryX=0.7500;entryY=1.0000;exitDx=0;exitDy=0;entryDx=0;entryDy=0;strokeColor=#14303a;strokeWidth=2;fontSize=11;fontColor=#14303a;labelBackgroundColor=#f7fafb;" edge="1" parent="1" source="arc" target="pub"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="est2" name="Estados de la propuesta de IA"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t" value="TurisPro · Estados de la propuesta de IA" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="800" height="34" as="geometry"/></mxCell><mxCell id="i" value="" style="ellipse;fillColor=#14303a;strokeColor=#14303a;" vertex="1" parent="1"><mxGeometry x="40" y="197" width="26" height="26" as="geometry"/></mxCell><mxCell id="sol" value='&lt;div style="text-align:center"&gt;&lt;b&gt;Solicitando datos&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;destino, duración, viajeros,&lt;br&gt;presupuesto por persona (COP)&lt;br&gt;e intereses' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=6;spacingTop=4;fontSize=12;fontColor=#14303a;fillColor=#dbeaf7;strokeColor=#6fa6d4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="110" y="150" width="220" height="120" as="geometry"/></mxCell><mxCell id="gen" value='&lt;div style="text-align:center"&gt;&lt;b&gt;Generando propuesta&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;do / usar recursos registrados&lt;br&gt;del destino' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=6;spacingTop=4;fontSize=12;fontColor=#14303a;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="150" width="220" height="120" as="geometry"/></mxCell><mxCell id="lis" value='&lt;div style="text-align:center"&gt;&lt;b&gt;Propuesta generada&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;itinerario por días y recomendaciones&lt;br&gt;costo estimado calculado por el sistema&lt;br&gt;informa si supera el presupuesto' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=6;spacingTop=4;fontSize=12;fontColor=#14303a;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="830" y="150" width="260" height="120" as="geometry"/></mxCell><mxCell id="ado" value='&lt;div style="text-align:center"&gt;&lt;b&gt;Adoptada&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;se guarda como plan en Borrador&lt;br&gt;y se edita en el editor común' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=6;spacingTop=4;fontSize=12;fontColor=#14303a;fillColor=#e1e5e8;strokeColor=#8a97a0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1230" y="150" width="240" height="120" as="geometry"/></mxCell><mxCell id="err" value='&lt;div style="text-align:center"&gt;&lt;b&gt;Sin resultado&lt;/b&gt;&lt;/div&gt;&lt;hr size="1"&gt;fallo del servicio o&lt;br&gt;faltan recursos del destino' style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingRight=6;spacingTop=4;fontSize=12;fontColor=#14303a;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="470" y="380" width="220" height="100" as="geometry"/></mxCell><mxCell id="f1" value="" style="ellipse;shape=endState;fillColor=#14303a;strokeColor=#14303a;" vertex="1" parent="1"><mxGeometry x="1540" y="195" width="30" height="30" as="geometry"/></mxCell><mxCell id="f2" value="" style="ellipse;shape=endState;fillColor=#14303a;strokeColor=#14303a;" vertex="1" parent="1"><mxGeometry x="830" y="415" width="30" height="30" as="geometry"/></mxCell><mxCell id="n0" value="La IA sugiere itinerarios y recomendaciones con recursos registrados; no inventa tarifas ni disponibilidad. Generar una propuesta nunca publica ni sustituye un plan guardado." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9e6;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=6;fontSize=11;fontColor=#14303a;" vertex="1" parent="1"><mxGeometry x="1230" y="330" width="330" height="110" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=10;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;exitDx=0;exitDy=0;entryDx=0;entryDy=0;strokeColor=#14303a;strokeWidth=2;fontSize=11;fontColor=#14303a;labelBackgroundColor=#f7fafb;" edge="1" parent="1" source="i" target="sol"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="proponerItinerario()&lt;br&gt;[datos válidos]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=10;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;exitDx=0;exitDy=0;entryDx=0;entryDy=0;strokeColor=#14303a;strokeWidth=2;fontSize=11;fontColor=#14303a;labelBackgroundColor=#f7fafb;" edge="1" parent="1" source="sol" target="gen"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="respuesta&lt;br&gt;correcta" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=10;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;exitDx=0;exitDy=0;entryDx=0;entryDy=0;strokeColor=#14303a;strokeWidth=2;fontSize=11;fontColor=#14303a;labelBackgroundColor=#f7fafb;" edge="1" parent="1" source="gen" target="lis"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="usarYEditar()" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=10;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;exitDx=0;exitDy=0;entryDx=0;entryDy=0;strokeColor=#14303a;strokeWidth=2;fontSize=11;fontColor=#14303a;labelBackgroundColor=#f7fafb;" edge="1" parent="1" source="lis" target="ado"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=10;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;exitDx=0;exitDy=0;entryDx=0;entryDy=0;strokeColor=#14303a;strokeWidth=2;fontSize=11;fontColor=#14303a;labelBackgroundColor=#f7fafb;" edge="1" parent="1" source="ado" target="f1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="fallo o&lt;br&gt;sin recursos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=10;exitX=0.5000;exitY=1.0000;entryX=0.5000;entryY=0.0000;exitDx=0;exitDy=0;entryDx=0;entryDy=0;strokeColor=#14303a;strokeWidth=2;fontSize=11;fontColor=#14303a;labelBackgroundColor=#f7fafb;" edge="1" parent="1" source="gen" target="err"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="continuar por&lt;br&gt;la ruta manual" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=10;exitX=1.0000;exitY=0.5000;entryX=0.0000;entryY=0.5000;exitDx=0;exitDy=0;entryDx=0;entryDy=0;strokeColor=#14303a;strokeWidth=2;fontSize=11;fontColor=#14303a;labelBackgroundColor=#f7fafb;" edge="1" parent="1" source="err" target="f2"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>